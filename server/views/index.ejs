<%- include('partials/header.ejs') %>

	<div class="px-6 py-4">
		<span class="text-slate-800 text-2xl font-semibold">My Reading Shelf</span>
	</div>
	<div class="flex flex-wrap gap-2 py-3 px-6">
		<% sortGrp.forEach((item)=> { %>
			<a href="<%= item.href %>" class="border text-sm px-4 py-1.5 rounded-full transition
      <%= item.active
        ? 'bg-[#1E2832] border-[#1E2832] text-[#F5C842]'
        : 'bg-white border-slate-300 text-slate-600 hover:border-[#1E2832] hover:text-[#1E2832]' %>">
				<%= item.label %>
			</a>
			<% }); %>
	</div>
	<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 px-6 py-4">
		<% books.forEach((book)=> { %>
			<a href="/book-detail/<%= book.id %>"
				class="stagger-in bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md hover:border-[#F5C842] group transition-all duration-200 hover:-translate-y-1"
				<!-- Book Cover -->
				<div class="bg-[#FEF9E7] h-52 flex items-center justify-center overflow-hidden relative">
					<% if (book.cover_id) { %>

						<!-- Skeleton loader -->
						<div class="skeleton absolute inset-0 bg-slate-200 animate-pulse"></div>

						<!-- Cover image -->
						<img src="https://covers.openlibrary.org/b/id/<%= book.cover_id %>-L.jpg" alt="<%= book.title %> cover"
							class="h-full w-full object-cover opacity-0 transition-opacity duration-300"
							onload="this.classList.remove('opacity-0'); this.previousElementSibling.remove();"
							onerror="this.remove(); this.previousElementSibling.remove();" />

						<% } else { %>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
								stroke-width="1.5" class="w-12 h-12 text-slate-300">
								<path stroke-linecap="round" stroke-linejoin="round"
									d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
							</svg>
							<% } %>
				</div>

				<div class="p-4">
					<h3 class="font-semibold text-[#1E2832] text-sm leading-snug mb-1 truncate">
						<%= book.title %>
					</h3>
					<p class="text-slate-500 text-xs mb-3 truncate">
						<%= book.author %>
					</p>

					<!-- Star Rating -->
					<div class="flex items-center gap-1">
						<% for (let i=1; i <=5; i++) { %>
							<svg xmlns="http://www.w3.org/2000/svg"
								class="w-3.5 h-3.5 <%= i <= parseInt(book.rating) ? 'text-[#F5C842]' : 'text-slate-200' %>"
								viewBox="0 0 24 24" fill="currentColor">
								<path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
							</svg>
							<% } %>
					</div>
				</div>

			</a>
			<% }); %>
	</div>
	<!-- ═══ PageMark AI Widget ═══════════════════════════════ -->
	<div id="pmai-root">

		<!-- Launcher -->
		<button id="pmai-launcher" type="button" aria-label="Open PageMark AI">
			<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="18" height="18">
				<path
					d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0z" />
			</svg>
			<span>Ask AI</span>
		</button>

		<!-- Panel -->
		<div id="pmai-panel" aria-hidden="true">

			<!-- Header -->
			<div id="pmai-header">
				<div id="pmai-header-left">
					<div id="pmai-avatar">
						<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="16" height="16">
							<path
								d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0z" />
						</svg>
					</div>
					<div>
						<p id="pmai-title">PageMark AI</p>
						<p id="pmai-subtitle">Your reading companion</p>
					</div>
				</div>
				<button id="pmai-close" type="button" aria-label="Close PageMark AI">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
						width="18" height="18">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>

			<!-- Messages -->
			<div id="pmai-messages">

				<!-- Welcome -->
				<div id="pmai-welcome">
					<div id="pmai-welcome-icon">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
							stroke-width="1.5" width="28" height="28">
							<path stroke-linecap="round" stroke-linejoin="round"
								d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
						</svg>
					</div>
					<h3 id="pmai-welcome-title">PageMark AI</h3>
					<p id="pmai-welcome-sub">Ask me about the books on your shelf, discover what you've read, or explore ideas
						from
						your collection.</p>
				<div id="pmai-chips">
				
					<button class="pmai-chip" data-prompt="What books are currently on the PageMark shelf?">
						What's on the shelf?
					</button>
				
					<button class="pmai-chip" data-prompt="Which books on the PageMark shelf have the highest ratings?">
						Highest rated?
					</button>
				
					<button class="pmai-chip"
						data-prompt="Which book from the PageMark shelf would you recommend exploring first, and why?">
						What should I explore?
					</button>
				
					<button class="pmai-chip" data-prompt="What genres are represented on the PageMark shelf?">
						Genres
					</button>
				
					<button class="pmai-chip" data-prompt="Give me an overview of the books currently on the PageMark shelf.">
						Shelf overview
					</button>
				
				</div>
				</div>

			</div>

			<!-- Input -->
			<form id="pmai-form">
				<textarea id="pmai-input" rows="1" placeholder="Ask PageMark AI..." autocomplete="off"></textarea>
				<button id="pmai-send" type="submit" aria-label="Send">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
						<path
							d="M3.478 2.405a.75.75 0 00-.926.94l2.432 7.905H13.5a.75.75 0 010 1.5H4.984l-2.432 7.905a.75.75 0 00.926.94 60.519 60.519 0 0018.445-8.986.75.75 0 000-1.218A60.517 60.517 0 003.478 2.405z" />
					</svg>
				</button>
			</form>

		</div>
	</div>
	<!-- ═══ End PageMark AI Widget ════════════════════════════ -->

	<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
	<script src="/js/ai-chat.js"></script>
	<%- include('partials/footer.ejs') %>