<%- include('partials/header.ejs') %>

	<div class="max-w-7xl mx-auto px-6 py-4 slide-up">

		<div class="flex flex-col sm:flex-row gap-8">

			<!-- Cover -->
			<div class="flex-shrink-0">
				<div
					class="relative bg-[#FEF9E7] rounded-xl overflow-hidden w-40 h-56 flex items-center justify-center shadow-sm border border-slate-200">

					<% if (book.cover_id) { %>

						<div class="absolute inset-0 animate-pulse bg-slate-200"></div>

						<!-- Image -->
						<img src="https://covers.openlibrary.org/b/id/<%= book.cover_id %>-L.jpg" alt="<%= book.title %> cover"
							class="max-h-full max-w-full object-contain opacity-0 transition-opacity duration-300 relative z-10"
							onload="
                            this.classList.remove('opacity-0');
                            this.previousElementSibling.classList.add('hidden');
                        " onerror="
                            this.remove();
                            this.previousElementSibling.remove();
                        ">

						<% } else { %>

							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
								stroke-width="1.5" class="w-12 h-12 text-slate-300">
								<path stroke-linecap="round" stroke-linejoin="round"
									d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 1 18 18a8.967 8.967 0 0 1-6 2.292m0-14.25v14.25" />
							</svg>

							<% } %>

				</div>
			</div>

			<!-- Info -->
			<div class="flex flex-col gap-3">

				<h1 class="text-2xl font-bold text-[#1E2832]">
					<%= book.title %>
				</h1>

				<p class="text-slate-500 text-sm">
					by <%= book.author %>
				</p>

				<!-- Stars -->
				<div class="flex items-center gap-1">

					<% for (let i=1; i <=5; i++) { %>

						<svg xmlns="http://www.w3.org/2000/svg"
							class="w-5 h-5 <%= i <= book.rating ? 'text-[#F5C842]' : 'text-slate-200' %>" viewBox="0 0 24 24"
							fill="currentColor">
							<path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
						</svg>

						<% } %>

				</div>

				<p class="text-sm text-slate-500">
					📅 Read on
					<span class="text-[#1E2832] font-medium">
						<%= new Date(book.date_read).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' , day: 'numeric'
							}) %>
					</span>
				</p>

				<!-- Actions -->
				<div class="flex flex-wrap gap-3 mt-2">

					<!-- Edit -->
					<a href="/edit-book/<%= book.id %>"
						class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-[#1E2832] text-white hover:bg-slate-700 transition">
						Edit
					</a>

					<!-- Ask AI -->
					<button type="button" id="ask-book-ai" data-book-id="<%= book.id %>" data-book-title="<%= book.title %>"
						data-book-author="<%= book.author %>" data-book-rating="<%= book.rating || 0 %>"
						data-book-genre="<%= book.genre || '' %>" data-book-notes="<%= book.notes || '' %>"
						class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-[#F5C842] text-[#1E2832] hover:bg-[#e6b932] transition">

						<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="16" height="16">
							<path
								d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 0 11.186 0z" />
						</svg>

						Ask AI about this book
					</button>

					<!-- Delete -->
					<form action="/delete-book/<%= book.id %>" method="POST">
						<button type="submit" onclick="return confirm('Delete this book?')"
							class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border border-red-200 text-red-600 hover:bg-red-50 transition">
							Delete
						</button>
					</form>

				</div>
			</div>
		</div>

		<!-- Notes -->
		<div class="mt-8">

			<h2 class="text-sm font-semibold text-slate-400 uppercase tracking-widest mb-3">
				My Notes
			</h2>

			<div class="bg-white border border-slate-200 rounded-xl p-6 text-slate-700 text-sm leading-relaxed shadow-sm">
				<%= book.notes || 'No notes added yet.' %>
			</div>

		</div>

	</div>
<!-- PageMark AI -->
<div id="pmai-root">




	<!-- Panel -->
<div id="pmai-panel" aria-hidden="true">

	<!-- Header -->
	<div id="pmai-header">
		<div id="pmai-header-left">
			<div id="pmai-avatar">
				<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="16" height="16">
					<path
						d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0z" />
				</svg>
			</div>
			<div>
				<p id="pmai-title">PageMark AI</p>
				<p id="pmai-subtitle">Your reading companion</p>
			</div>
		</div>
		<button id="pmai-close" type="button" aria-label="Close PageMark AI">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
				width="18" height="18">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>
	</div>

	<!-- Messages -->
	<div id="pmai-messages">

		<!-- Welcome -->
		<div id="pmai-welcome">
			<div id="pmai-welcome-icon">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"
					width="28" height="28">
					<path stroke-linecap="round" stroke-linejoin="round"
						d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
				</svg>
			</div>
		<h3 id="pmai-welcome-title">
			Ask about this book
		</h3>
		
		<p id="pmai-welcome-sub">
			Explore the ideas, themes, and notes about this book.
		</p>
		<div id="pmai-chips">
		
			<button class="pmai-chip" data-prompt="What is this book about?">
				What is it about?
			</button>
		
			<button class="pmai-chip" data-prompt="What are the key ideas from this book?">
				Key ideas
			</button>
		
			<button class="pmai-chip" data-prompt="What are the most useful lessons from this book?">
				Key lessons
			</button>
		
			<button class="pmai-chip" data-prompt="How can the ideas from this book be applied in real life?">
				How can I apply it?
			</button>
		
			<button class="pmai-chip" data-prompt="Summarise the notes about this book on PageMark.">
				Summarise the notes
			</button>
		
		</div>
		</div>

	</div>

	<!-- Input -->
	<form id="pmai-form">
		<textarea id="pmai-input" rows="1" placeholder="Ask PageMark AI..." autocomplete="off"></textarea>
		<button id="pmai-send" type="submit" aria-label="Send">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
				<path
					d="M3.478 2.405a.75.75 0 00-.926.94l2.432 7.905H13.5a.75.75 0 010 1.5H4.984l-2.432 7.905a.75.75 0 00.926.94 60.519 60.519 0 0018.445-8.986.75.75 0 000-1.218A60.517 60.517 0 003.478 2.405z" />
			</svg>
		</button>
	</form>

</div>

</div>
	<!-- Marked -->
	<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

	<!-- PageMark AI -->
	<script src="/js/ai-chat.js"></script>


	<%- include('partials/footer.ejs') %>